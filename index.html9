<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#06111e"><title>DOSBALL Super Sport International</title><style>
:root{--bg:#06111e;--panel:#0b1d30;--text:#f5f8fb;--muted:#b9c8d7;--gold:#d8b55b;--gold2:#f0d88d;--line:rgba(216,181,91,.42);--danger:#ff6b6b;--r:22px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,system-ui,-apple-system,"Segoe UI",Arial,sans-serif;background:radial-gradient(circle at 20% 0,#102d4a 0,#06111e 32%,#040a12 100%);color:var(--text);line-height:1.68}.hero{min-height:94vh;display:flex;align-items:center;position:relative;border-bottom:1px solid var(--line);background:linear-gradient(180deg,rgba(3,10,18,.18),rgba(3,10,18,.78)),radial-gradient(circle at 75% 20%,rgba(47,168,255,.25),transparent 28%),radial-gradient(circle at 20% 75%,rgba(216,181,91,.18),transparent 30%)}.hero-inner,.container{width:min(1140px,92%);margin:auto}.hero-inner{text-align:center;padding:120px 0 40px}.lang{position:absolute;top:18px;left:3%;right:3%;z-index:5;display:flex;justify-content:center;flex-wrap:wrap;gap:6px}.lang button{background:rgba(4,13,23,.78);border:1px solid var(--line);color:white;padding:7px 10px;border-radius:999px;font-size:12px}.lang button.active{background:var(--gold);color:#06111e;font-weight:800}.badge{display:inline-block;border:1px solid var(--line);border-radius:999px;padding:8px 14px;color:var(--gold2);font-size:12px;letter-spacing:.13em}.hero h1{font-size:clamp(54px,11vw,116px);line-height:.88;margin:25px 0 8px;letter-spacing:-.055em}.hero-sub{font-size:clamp(17px,3vw,32px);letter-spacing:.22em;color:var(--gold2);font-weight:800}.hero-copy,.lead{font-size:clamp(17px,2.1vw,21px);color:#dce7f0;max-width:900px}.hero-copy{margin:25px auto}.hero-logos{margin:46px auto 0;display:flex;justify-content:center;gap:22px;flex-wrap:wrap}.hero-logo{width:145px;height:145px;border:1px solid var(--line);border-radius:26px;background:rgba(7,20,34,.65);padding:12px}.hero-logo img{width:100%;height:100%;object-fit:contain;border-radius:18px}.nav-wrap{position:sticky;top:0;z-index:40;background:rgba(4,11,19,.95);border-bottom:1px solid var(--line);backdrop-filter:blur(12px)}.nav{width:min(1220px,96%);margin:auto;padding:10px 0;display:flex;gap:8px;overflow-x:auto;scrollbar-width:none}.nav a{white-space:nowrap;text-decoration:none;border:1px solid var(--gold);border-radius:10px;padding:9px 12px;font-size:12px;font-weight:900;color:white}.section{padding:72px 0;border-bottom:1px solid rgba(216,181,91,.13);scroll-margin-top:72px}.kicker{color:var(--gold);font-size:12px;letter-spacing:.2em;font-weight:900}.section h2{margin:5px 0 22px;font-size:clamp(31px,5.5vw,54px);letter-spacing:-.035em}.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:18px}.card{grid-column:span 4;background:linear-gradient(180deg,rgba(15,38,60,.92),rgba(8,24,40,.92));border:1px solid rgba(216,181,91,.28);border-radius:var(--r);padding:23px}.card h3{margin:0 0 9px;color:var(--gold2)}.card p{margin:0;color:#cad7e4}.metric{font-size:38px;font-weight:900;line-height:1;margin-bottom:8px}.video-shell{position:relative;padding-top:56.25%;border-radius:24px;overflow:hidden;border:1px solid var(--line);background:#000}.video-shell iframe{position:absolute;inset:0;width:100%;height:100%;border:0}.gallery{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px;margin-top:22px}.gallery img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:14px;border:1px solid rgba(216,181,91,.25)}.video-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;margin-top:18px}.video-grid video{width:100%;border-radius:15px;border:1px solid var(--line);background:#000}.split{display:grid;grid-template-columns:1.05fr .95fr;gap:30px;align-items:center}.notice{border:1px solid var(--gold);background:linear-gradient(135deg,rgba(216,181,91,.13),rgba(47,168,255,.06));padding:24px;border-radius:20px}.danger{border-color:rgba(255,107,107,.65);background:linear-gradient(135deg,rgba(255,107,107,.12),rgba(216,181,91,.05))}.logos-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px;max-width:760px;margin:30px auto}.logo-display{height:300px;border:1px solid var(--line);border-radius:28px;display:grid;place-items:center;padding:26px;background:rgba(255,255,255,.03)}.logo-display img{width:100%;height:100%;object-fit:contain}.author-photo{width:100%;max-width:390px;aspect-ratio:4/5;object-fit:cover;border-radius:28px;border:1px solid var(--line);display:block;margin:auto}.timeline{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:22px}.timeline div{padding:18px;border-left:2px solid var(--gold);background:rgba(255,255,255,.025)}.year{font-size:27px;font-weight:900;color:var(--gold2)}.cta{display:inline-block;text-decoration:none;background:var(--gold);color:#06111e;font-weight:900;padding:13px 20px;border-radius:13px;margin-top:12px}.muted{color:var(--muted)}footer{padding:38px 0 55px;text-align:center;color:#9fb1c2}@media(max-width:820px){.card{grid-column:span 6}.split{grid-template-columns:1fr}.timeline{grid-template-columns:1fr}.logos-grid{grid-template-columns:1fr}}@media(max-width:520px){.card{grid-column:span 12}.section{padding:56px 0}.hero-logo{width:120px;height:120px}}
</style></head><body>
<div class="lang"><button data-lang="en">🇬🇧 English</button><button data-lang="ru">🇷🇺 Русский</button><button data-lang="ja">🇯🇵 日本語</button><button data-lang="zh">🇨🇳 中文</button><button data-lang="tr">🇹🇷 Türkçe</button><button data-lang="ko">🇰🇷 한국어</button><button data-lang="ar">🇸🇦 العربية</button></div>
<header id="home" class="hero"><div class="hero-inner"><span class="badge">NEW GLOBAL TEAM SPORT • SPORT + DIGITAL + CLUBS + CAREER</span><h1>DOSBALL</h1><div class="hero-sub">SUPER SPORT INTERNATIONAL</div><p class="hero-copy" data-t="hero"></p><div class="hero-logos"><div class="hero-logo"><img src="data:image/png;base64," alt="DOSBALL logo"></div><div class="hero-logo"><img src="data:image/png;base64," alt="DOSBALL Federation logo"></div></div></div></header>
<div class="nav-wrap"><nav class="nav"><a href="#home">HOME</a><a href="#video">VIDEO</a><a href="#about">ABOUT</a><a href="#sport">SPORT</a><a href="#how">HOW TO PLAY</a><a href="#gallery">GALLERY</a><a href="#game">VIDEO GAME</a><a href="#clubs">CLUBS</a><a href="#leagues">LEAGUES</a><a href="#career">CAREER</a><a href="#international">INTERNATIONAL</a><a href="#franchise">FRANCHISE</a><a href="#rewards">REWARDS</a><a href="#education">EDUCATION</a><a href="#social">SOCIAL MISSION</a><a href="#logos">LOGOS</a><a href="#legal">LEGAL</a><a href="#history">HISTORY</a><a href="#author">AUTHOR</a><a href="#contacts">CONTACTS</a></nav></div>
<section id="video" class="section"><div class="container"><div class="kicker">01 • FIRST IMPRESSION</div><h2>OFFICIAL VIDEO</h2><p class="lead" data-t="video"></p><div class="video-shell"><iframe src="https://www.youtube.com/embed/AxgTkmCzCDU" title="DOSBALL Official Video" allowfullscreen></iframe></div></div></section>
<section id="about" class="section"><div class="container"><div class="kicker">02 • THE IDEA</div><h2>ABOUT DOSBALL</h2><p class="lead" data-t="about"></p><div class="grid"><div class="card"><div class="metric">2006</div><h3>ORIGIN</h3><p>Concept created.</p></div><div class="card"><div class="metric">2008 / 2013</div><h3>REGISTRATION</h3><p>Key formal registration stages.</p></div><div class="card"><div class="metric">10–70</div><h3>ATHLETE PATH</h3><p>Long-term participation concept.</p></div></div></div></section>
<section id="sport" class="section"><div class="container"><div class="kicker">03 • REAL COMPETITION</div><h2>THE SPORT</h2><p class="lead" data-t="sport"></p><div class="grid"><div class="card"><div class="metric">6</div><h3>ON COURT</h3><p>Six athletes per team on the court.</p></div><div class="card"><div class="metric">3 × 20</div><h3>MATCH FORMAT</h3><p>Three periods of clean playing time.</p></div><div class="card"><div class="metric">3</div><h3>VERTICAL RINGS</h3><p>Distinctive scoring targets on each side.</p></div></div></div></section>
<section id="how" class="section"><div class="container"><div class="kicker">04 • PROTECTED KNOW-HOW</div><h2>HOW DOSBALL IS PLAYED</h2><div class="split"><p class="lead" data-t="how"></p><div class="notice"><h3>OFFICIAL RULES ACCESS</h3><p class="muted" data-t="how"></p></div></div><div class="grid" style="margin-top:22px"><div class="card" style="grid-column:span 6"><h3>WHY DOSBALL IS DIFFERENT</h3><p data-t="diff"></p></div><div class="card" style="grid-column:span 6"><h3>ONE OFFICIAL STANDARD</h3><p>The Federation maintains the controlled official ruleset for authorized clubs and competitions.</p></div></div></div></section>
<section id="gallery" class="section"><div class="container"><div class="kicker">05 • ONE VISUAL STORY</div><h2>GALLERY</h2><p class="lead" data-t="gallery"></p><div id="galleryGrid" class="gallery"></div><h3 style="margin-top:30px">VIDEO TESTIMONIALS</h3><div id="videoGrid" class="video-grid"></div></div></section>
<section id="game" class="section"><div class="container"><div class="kicker">06 • DIGITAL ENTRY</div><h2>VIDEO GAME</h2><p class="lead" data-t="game"></p><div class="grid"><div class="card"><div class="metric">$11</div><h3>MONTHLY ACCESS</h3><p>Digital DOSBALL access.</p></div><div class="card"><div class="metric">FREE</div><h3>REGISTRATION</h3><p>Federation participant registration.</p></div><div class="card"><h3>DIGITAL → REAL</h3><p>Discover digitally, continue in an authorized club.</p></div></div></div></section>
<section id="clubs" class="section"><div class="container"><div class="kicker">07 • REAL TRAINING</div><h2>CLUBS & TRAINING</h2><p class="lead" data-t="clubs"></p><div class="grid"><div class="card"><div class="metric">$30</div><h3>MONTHLY CLUB</h3></div><div class="card"><div class="metric">12</div><h3>SESSIONS</h3></div><div class="card"><div class="metric">2H</div><h3>EACH SESSION</h3></div></div></div></section>
<section id="leagues" class="section"><div class="container"><div class="kicker">08 • PROFESSIONAL PATH</div><h2>LEAGUES & CHAMPIONSHIPS</h2><p class="lead" data-t="leagues"></p><div class="grid"><div class="card"><h3>PREMIER LEAGUE</h3></div><div class="card"><h3>HIGH LEAGUE</h3></div><div class="card"><h3>SUPER NATIONAL LEAGUE</h3></div></div></div></section>
<section id="career" class="section"><div class="container"><div class="kicker">09 • MORE THAN A SEASON</div><h2>ATHLETE CAREER</h2><p class="lead" data-t="career"></p><div class="timeline"><div><span class="year">01</span><br><b>CLUB ATHLETE</b></div><div><span class="year">02</span><br><b>COMPETITION & CHAMPIONSHIP</b></div><div><span class="year">03</span><br><b>LEADERSHIP & DEVELOPMENT</b></div></div></div></section>
<section id="international" class="section"><div class="container"><div class="kicker">10 • GLOBAL DEVELOPMENT</div><h2>INTERNATIONAL DOSBALL</h2><p class="lead" data-t="international"></p></div></section>
<section id="franchise" class="section"><div class="container"><div class="kicker">11 • AUTHORIZED GROWTH</div><h2>FRANCHISE & BUSINESS</h2><p class="lead" data-t="franchise"></p></div></section>
<section id="rewards" class="section"><div class="container"><div class="kicker">12 • REAL ACTIVITY REWARDS</div><h2>REFERRAL & REWARDS</h2><p class="lead" data-t="rewards"></p><div class="grid"><div class="card"><div class="metric">$2</div><h3>VIDEO GAME</h3></div><div class="card"><div class="metric">$3</div><h3>CLUB TRAINING</h3></div><div class="card"><div class="metric">10%</div><h3>QUALIFYING FRANCHISE</h3></div></div></div></section>
<section id="education" class="section"><div class="container"><div class="kicker">13 • PUBLIC EDUCATION</div><h2>EDUCATION</h2><p class="lead" data-t="education"></p><div class="notice"><h3>FREE EDUCATIONAL USE ≠ COMMERCIAL LICENSE</h3><p class="muted" data-t="education"></p></div></div></section>
<section id="social" class="section"><div class="container"><div class="kicker">14 • VALUES</div><h2>SOCIAL MISSION</h2><p class="lead" data-t="social"></p><div class="grid"><div class="card"><h3>FAIR PLAY</h3></div><div class="card"><h3>UNITY</h3></div><div class="card"><h3>PROGRESS</h3></div></div></div></section>
<section id="logos" class="section"><div class="container"><div class="kicker">15 • OFFICIAL IDENTITY</div><h2>LOGOS</h2><p class="lead" data-t="logos"></p><div class="logos-grid"><div class="logo-display"><img src="data:image/png;base64," alt="Approved DOSBALL logo"></div><div class="logo-display"><img src="data:image/png;base64," alt="Approved DOSBALL Federation logo"></div></div></div></section>
<section id="legal" class="section"><div class="container"><div class="kicker">16 • PROTECTION & COMPLIANCE</div><h2>BRAND & LEGAL PROTECTION</h2><div class="grid"><div class="card" style="grid-column:span 6"><h3>BRAND & EQUIPMENT PROTECTION</h3><p data-t="brand"></p></div><div class="card" style="grid-column:span 6"><h3>AUTHORIZED PAID TRAINING</h3><p data-t="paid"></p></div></div><div class="notice danger" style="margin-top:22px"><h3>NO GAMBLING • NO BETTING • NO LOTTERIES</h3><p data-t="gambling"></p></div></div></section>
<section id="history" class="section"><div class="container"><div class="kicker">17 • ORIGIN & DEVELOPMENT</div><h2>HISTORY OF DOSBALL</h2><p class="lead" data-t="history"></p><div class="timeline"><div><span class="year">2006</span><br><b>CONCEPT</b></div><div><span class="year">2008</span><br><b>REGISTRATION STAGE</b></div><div><span class="year">2013</span><br><b>DOSBALL</b></div></div></div></section>
<section id="author" class="section"><div class="container"><div class="kicker">18 • FOUNDER & INVENTOR</div><h2>AUTHOR</h2><div class="split"><img class="author-photo" src="data:image/png;base64," alt="Askar Jambulatov"><div><h3 style="font-size:30px">ASKAR JAMBULATOV</h3><p class="lead" data-t="author"></p></div></div></div></section>
<section id="contacts" class="section"><div class="container"><div class="kicker">19 • JOIN THE DEVELOPMENT</div><h2>CONTACTS</h2><p class="lead" data-t="contact"></p><a class="cta" href="mailto:dosballsupersport@gmail.com">CONTACT DOSBALL</a></div></section>
<footer><div class="container"><b>DOSBALL SUPER SPORT INTERNATIONAL</b><br>Fair Play • Unity • Progress<br><span class="muted">© 2026 DOSBALL. All rights reserved. Public presentation — detailed official game rules are not published here.</span></div></footer>
<script>const COPY={"en": {"hero": "A new international team sport built as one connected ecosystem: real competition, clubs, professional leagues, a digital game, athlete development, education, franchising and international Federation growth.", "video": "Start with the official DOSBALL promotional video — the fastest way to feel the atmosphere, scale and future direction of the sport.", "about": "DOSBALL was conceived in 2006 as a sport people can understand quickly but continue mastering for years. It combines speed, coordination, strength, accuracy, tactical movement and team responsibility in one competitive identity.", "sport": "Two teams compete on a basketball-size court with a distinctive three-ring scoring concept. The match changes its physical and tactical character across periods, including play in athletic shoes and a roller-skating period.", "how": "The public website explains only the basic concept. The complete Official DOSBALL Rules, special situations and technical interpretations are not published openly at this stage. Full access is provided to athletes who become members of an authorized DOSBALL Club.", "diff": "DOSBALL uses familiar athletic skills inside an unfamiliar competitive system. It is designed not as a copy of another sport, but as a new athlete and spectator experience with fast transitions, changing tactics and visible scoring targets.", "gallery": "One sport, one Federation, one visual story. Numbered photos already stored in the project gallery folder are loaded automatically; local presentation and testimonial videos are loaded from the videos folder.", "game": "The DOSBALL Video Game is the digital entrance to the ecosystem. Planned monthly access is $11, while Federation participant registration remains free. The digital product is designed to lead interested players toward real clubs and competition.", "clubs": "Authorized DOSBALL Clubs are where the sport becomes real. The standard model is $30 per month for 12 training sessions of two hours, combining technique, conditioning, teamwork and competition preparation. Club membership also opens access to the complete official rules.", "leagues": "The professional pathway develops through Premier League, High League and Super National League, creating a visible ladder from club competition toward stronger national and future international championships.", "career": "DOSBALL is designed to give athletes a future beyond one season. Competitive success can lead from club athlete to champion, then toward leadership opportunities, regional development roles and participation in the wider Federation structure.", "international": "The long-term model is international: authorized regional clubs, national systems, professional leagues and recurring competitions in new countries — all connected by one sporting identity and controlled standards.", "franchise": "The franchise system is the business infrastructure for authorized club development. Approved partners may develop DOSBALL in an agreed territory under Federation standards, brand rules and operating conditions, with further expansion possible after successful development and approval.", "rewards": "The referral system rewards real paid activity, not recruitment by itself: up to $2 for each qualifying paid monthly Video Game access by a referred user, $3 for each qualifying paid club month while the referred athlete continues training, and 10% under qualifying champion-career franchise terms.", "education": "Schools, colleges and universities may conduct DOSBALL educational sessions free of charge after signing a digital agreement with DOSBALL Federation and, where required, complying with the relevant Ministry of Education or competent education authority. Paid sections, paid official training and commercial competitions require Federation authorization.", "social": "DOSBALL connects sport, family, society, education, public institutions and responsible business. Fair Play, Unity and Progress are intended to guide athlete development, club culture and international cooperation.", "logos": "These are the two current approved DOSBALL marks for public presentation. They are displayed at equal visual scale and should replace outdated logo versions in future public DOSBALL materials.", "brand": "DOSBALL names, logos, visual identity and authorized equipment may be protected under applicable intellectual-property rights. Unauthorized copying, imitation, alteration, counterfeiting, manufacturing, marketing or sale of products bearing DOSBALL marks may be pursued under the laws and competent authorities or courts of the country where the conduct occurs.", "paid": "Paid DOSBALL sections, training programs or other commercial DOSBALL activity may not be operated without Federation authorization. Legal remedies, damages, injunctions or other measures may be pursued where available under applicable law; no single automatic penalty is claimed for every jurisdiction.", "gambling": "DOSBALL must not be used for sports betting, wagering, bookmakers, gambling, lotteries, lottery-style schemes or similar monetary games of chance. The prohibition applies to DOSBALL competitions, clubs, names, logos, media and other official elements, with remedies pursued under applicable law where available.", "history": "The DOSBALL concept began in 2006 and developed through later registration stages in 2008 and 2013. What started as a new team-sport idea gradually expanded into a connected system of physical sport, digital participation, clubs, leagues, education, career development and international organization.", "author": "Askar Jambulatov is the founder and inventor of DOSBALL Super Sport International. His goal is not only to introduce a new game, but to build a lasting sports system able to connect generations of athletes, clubs and countries through one recognizable international identity.", "contact": "DOSBALL welcomes serious inquiries from athletes, clubs, educational institutions, partners, investors and future regional representatives interested in authorized participation and international development."}, "ru": {"hero": "Новый международный командный спорт, создаваемый как единая экосистема: реальные соревнования, клубы, профессиональные лиги, цифровая игра, развитие спортсмена, образование, франшиза и международная Федерация.", "video": "Начните с официального рекламного видео DOSBALL — оно быстрее всего передаёт атмосферу, масштаб и направление развития нового спорта.", "about": "DOSBALL был задуман в 2006 году как спорт, принцип которого можно понять быстро, но совершенствоваться в нём годами. Он соединяет скорость, координацию, силу, точность, тактическое движение и командную ответственность в одной спортивной системе.", "sport": "Две команды играют на площадке баскетбольного размера с уникальной системой трёх колец. Характер матча меняется по периодам: используются этапы в спортивной обуви и отдельный период на роликовых коньках, поэтому меняются физические и тактические задачи.", "how": "Публичный сайт раскрывает только общий принцип DOSBALL. Полные Official DOSBALL Rules, специальные игровые ситуации и технические трактовки пока не публикуются в открытом доступе. Полный доступ получают спортсмены после вступления в авторизованный клуб DOSBALL.", "diff": "DOSBALL использует знакомые спортивные навыки внутри совершенно новой соревновательной системы. Это не копия другого спорта, а самостоятельный опыт для спортсмена и зрителя — с быстрыми переходами, сменой тактики и заметными целями для взятия.", "gallery": "Один спорт, одна Федерация, одна визуальная история. Пронумерованные фотографии из папки gallery и локальные презентационные видео из папки videos подгружаются автоматически.", "game": "DOSBALL Video Game — цифровой вход в экосистему. Планируемый доступ — $11 в месяц, при этом регистрация участника Федерации остаётся бесплатной. Цифровой продукт должен вести заинтересованного игрока к настоящему клубу и реальным соревнованиям.", "clubs": "Авторизованные клубы DOSBALL — место, где спорт становится реальным. Стандартная модель — $30 в месяц за 12 тренировок по два часа: техника, физическая подготовка, командная работа и подготовка к соревнованиям. Членство в клубе также открывает доступ к полным официальным правилам.", "leagues": "Профессиональный путь строится через Premier League, High League и Super National League, создавая понятную лестницу от клубных соревнований к более сильным национальным и будущим международным чемпионатам.", "career": "DOSBALL создаётся так, чтобы у спортсмена была перспектива дальше одного сезона. Спортивный успех может вести от игрока клуба к чемпиону, а затем к лидерским возможностям, региональному развитию и участию в более широкой структуре Федерации.", "international": "Долгосрочная модель международная: авторизованные региональные клубы, национальные системы, профессиональные лиги и регулярные соревнования в новых странах — всё под единой спортивной идентичностью и контролируемыми стандартами.", "franchise": "Франшиза является деловой инфраструктурой для развития авторизованных клубов. Одобренные партнёры могут развивать DOSBALL на согласованной территории по стандартам Федерации и правилам бренда, а после успешного развития и одобрения возможно дальнейшее расширение.", "rewards": "Реферальная система вознаграждает реальную оплаченную активность, а не само привлечение: до $2 за каждый квалифицируемый оплаченный месяц Video Game приглашённого пользователя, $3 за каждый квалифицируемый оплаченный месяц клуба и 10% при выполнении условий чемпионского карьерного уровня и соответствующей покупки франшизы.", "education": "Школы, колледжи и университеты могут проводить образовательные занятия DOSBALL бесплатно после подписания цифрового договора с DOSBALL Federation и, если требуется, соблюдения требований Министерства образования или другого компетентного образовательного органа. Платные секции, официальные платные тренировки и коммерческие соревнования требуют разрешения Федерации.", "social": "DOSBALL объединяет спорт, семью, общество, образование, государственные институты и ответственный бизнес. Fair Play, Unity и Progress должны определять развитие спортсменов, культуру клубов и международное сотрудничество.", "logos": "Это два актуальных утверждённых знака DOSBALL для публичной презентации. Они показаны в одинаковом визуальном масштабе и должны заменить устаревшие версии логотипов в будущих материалах DOSBALL.", "brand": "Названия, логотипы, фирменный стиль и авторизованная экипировка DOSBALL могут охраняться применимыми правами интеллектуальной собственности. Несанкционированное копирование, имитация, изменение, подделка, производство, реклама или продажа товаров со знаками DOSBALL может преследоваться по законам и через компетентные органы или суды той страны, где произошло нарушение.", "paid": "Платные секции, тренировочные программы и иная коммерческая деятельность DOSBALL не могут проводиться без разрешения Федерации. Возможные требования о прекращении нарушения, возмещении ущерба и другие меры применяются только в пределах законодательства конкретной страны; единый автоматический штраф для всех государств не заявляется.", "gambling": "DOSBALL строго запрещено использовать для спортивных ставок, денежных пари, букмекерской деятельности, азартных игр, лотерей и других денежных игр, основанных на случайности. Запрет распространяется на соревнования, клубы, название, логотипы, медиа и другие официальные элементы DOSBALL, а защита прав осуществляется в рамках применимого законодательства.", "history": "Концепция DOSBALL появилась в 2006 году и прошла последующие этапы регистрации в 2008 и 2013 годах. Идея нового командного спорта постепенно выросла в связанную систему реального спорта, цифрового участия, клубов, лиг, образования, карьерного развития и международной организации.", "author": "Аскар Джамбулатов — основатель и изобретатель DOSBALL Super Sport International. Его цель — не просто представить новую игру, а создать долгоживущую спортивную систему, способную объединять поколения спортсменов, клубы и страны одной узнаваемой международной идентичностью.", "contact": "DOSBALL открыт для серьёзных обращений от спортсменов, клубов, образовательных учреждений, партнёров, инвесторов и будущих региональных представителей по вопросам авторизованного участия и международного развития."}, "ja": {"hero": "新しい国際チームスポーツとして、実際の競技、クラブ、プロリーグ、デジタルゲーム、選手育成、教育、フランチャイズ、国際連盟の発展を一つに結びます。", "video": "公式プロモーション映像から始めてください。DOSBALLの雰囲気と規模、将来像を最も早く理解できます。", "about": "DOSBALLは2006年に構想され、スピード、協調性、パワー、正確性、戦術、チーム責任を一つの競技に統合することを目指します。", "sport": "2チームがバスケットボール規模のコートで独自の3リング得点システムを使い、運動靴とローラースケートの異なる局面が戦術を変化させます。", "how": "公開サイトでは基本概念のみを説明し、完全な公式ルールは公開しません。完全版は認定DOSBALLクラブ会員の選手に提供されます。", "diff": "DOSBALLは既存競技のコピーではなく、馴染みある運動能力を新しい競争構造に置き換えた独自の選手・観客体験です。", "gallery": "一つのスポーツ、一つの連盟、一つのビジュアルストーリーとして、galleryとvideosフォルダの素材を自動表示します。", "game": "DOSBALL Video Gameはデジタル入口です。月額$11を予定し、連盟登録は無料のままです。", "clubs": "認定クラブは月額$30、月12回、各2時間の標準トレーニングを想定し、会員は完全な公式ルールへアクセスできます。", "leagues": "Premier League、High League、Super National Leagueがクラブ競技から国内・国際大会への道を作ります。", "career": "成功した選手はクラブ選手からチャンピオン、さらにリーダーシップや地域開発、連盟活動へ進む可能性があります。", "international": "長期目標は、認定地域クラブ、国内システム、プロリーグ、国際大会を共通基準で発展させることです。", "franchise": "フランチャイズは認定クラブ発展の事業基盤であり、承認された地域で連盟基準とブランド規則に従って運営されます。", "rewards": "紹介制度は実際の有料活動を対象に、条件に応じてVideo Game月$2、クラブ月$3、対象フランチャイズ10%の報酬を設けます。", "education": "学校・大学等はデジタル契約と必要な教育当局の要件を満たせば無料の非商業教育が可能で、有料活動には連盟許可が必要です。", "social": "DOSBALLはスポーツ、家族、社会、教育、公的機関、責任あるビジネスをFair Play・Unity・Progressでつなぎます。", "logos": "現在承認されている2つのDOSBALLロゴを同じ視覚サイズで表示し、旧ロゴに代えて使用します。", "brand": "DOSBALLの名称・ロゴ・認定用品の無断複製、模倣、偽造、製造、販売は、発生国の知的財産法等に基づき法的対応の対象となる場合があります。", "paid": "連盟許可のない有料DOSBALL教室や商業活動は禁止され、法的措置は各国の適用法と管轄機関・裁判所を通じて行われます。", "gambling": "DOSBALLをスポーツ賭博、金銭賭博、ブックメーカー、ギャンブル、宝くじ等に利用することを厳格に禁止します。", "history": "DOSBALLは2006年に始まり、2008年と2013年の登録段階を経て、スポーツ、デジタル、クラブ、リーグ、教育、国際組織へ発展しました。", "author": "Askar JambulatovはDOSBALL Super Sport Internationalの創設者・発明者で、世代・クラブ・国を結ぶ長期的なスポーツ体系を目指しています。", "contact": "選手、クラブ、教育機関、パートナー、投資家、地域代表候補からの正式な問い合わせを歓迎します。"}, "zh": {"hero": "一项新的国际团队运动，把实体比赛、俱乐部、职业联赛、数字游戏、运动员成长、教育、特许经营和国际联合会发展连接成一个完整生态。", "video": "请先观看官方宣传视频，这是感受DOSBALL氛围、规模和未来方向最快的方式。", "about": "DOSBALL构想始于2006年，目标是在一个竞技体系中结合速度、协调、力量、精准、战术移动和团队责任。", "sport": "两支队伍在篮球场大小的场地上使用独特的三环得分体系，并通过运动鞋阶段和轮滑阶段改变比赛的身体与战术要求。", "how": "公开网站只介绍基本概念，完整官方规则暂不公开。只有成为授权DOSBALL俱乐部成员的运动员才能获得完整规则。", "diff": "DOSBALL不是现有运动的复制，而是把熟悉的运动能力放入新的竞争结构，为运动员和观众创造新的体验。", "gallery": "一个运动、一个联合会、一段视觉故事；gallery与videos文件夹中的素材自动显示。", "game": "DOSBALL Video Game是数字入口，计划月费$11，联合会参与者注册保持免费。", "clubs": "授权俱乐部标准模式为每月$30、12次、每次2小时训练，俱乐部会员同时获得完整官方规则。", "leagues": "Premier League、High League和Super National League构成从俱乐部赛事走向更高级国内及未来国际锦标赛的职业阶梯。", "career": "优秀运动员可从俱乐部球员成长为冠军，并进一步获得领导、区域发展和参与联合会体系的机会。", "international": "长期目标是在统一标准下发展区域俱乐部、国家体系、职业联赛及在新国家举办的国际赛事。", "franchise": "特许经营是授权俱乐部发展的商业基础，获批伙伴在约定区域按照联合会标准和品牌规则运营。", "rewards": "推荐制度只奖励真实付费活动，符合条件时可产生Video Game每月$2、俱乐部每月$3以及合格特许经营10%的奖励。", "education": "学校、学院和大学在签署数字协议并遵守必要的教育主管机构要求后，可免费开展非商业教育；收费活动需联合会授权。", "social": "DOSBALL以Fair Play、Unity和Progress连接体育、家庭、社会、教育、公共机构和负责任商业。", "logos": "网站以相同视觉尺寸展示目前批准的两款DOSBALL标志，未来公开材料应替代旧版本。", "brand": "未经授权复制、模仿、修改、伪造、制造或销售带有DOSBALL标志的产品，可依据行为发生国的知识产权等法律追究。", "paid": "未经联合会许可，不得经营收费DOSBALL课程或商业活动；法律措施依行为发生国的适用法律、主管机关和法院进行。", "gambling": "严禁将DOSBALL用于体育博彩、金钱投注、博彩公司、赌博、彩票或类似的金钱机会游戏。", "history": "DOSBALL始于2006年，并经历2008年和2013年的注册阶段，随后发展为体育、数字、俱乐部、联赛、教育和国际组织的综合体系。", "author": "Askar Jambulatov是DOSBALL Super Sport International的创始人和发明者，目标是建立连接世代运动员、俱乐部和国家的长期体育体系。", "contact": "欢迎运动员、俱乐部、教育机构、合作伙伴、投资者和未来区域代表就授权参与和国际发展进行正式联系。"}, "tr": {"hero": "Yeni bir uluslararası takım sporu olarak gerçek müsabakaları, kulüpleri, profesyonel ligleri, dijital oyunu, sporcu gelişimini, eğitimi, franchise sistemini ve uluslararası Federasyon büyümesini tek ekosistemde birleştirir.", "video": "DOSBALL atmosferini, ölçeğini ve gelecek yönünü en hızlı şekilde görmek için resmi tanıtım videosuyla başlayın.", "about": "DOSBALL 2006’da tasarlandı; hız, koordinasyon, güç, isabet, taktik hareket ve takım sorumluluğunu tek rekabet kimliğinde birleştirmeyi amaçlar.", "sport": "İki takım basketbol sahası büyüklüğündeki alanda özgün üç halka skor sistemiyle oynar; spor ayakkabılı ve patenli dönemler fiziksel ve taktik yapıyı değiştirir.", "how": "Kamuya açık site yalnız temel konsepti anlatır; tam resmi kurallar yayımlanmaz ve yalnız yetkili DOSBALL Kulübü üyesi sporculara verilir.", "diff": "DOSBALL başka bir sporun kopyası değil, tanıdık atletik becerileri yeni bir rekabet sistemine taşıyan özgün sporcu ve seyirci deneyimidir.", "gallery": "Tek spor, tek Federasyon, tek görsel hikâye; gallery ve videos klasörlerindeki içerik otomatik yüklenir.", "game": "DOSBALL Video Game dijital giriş kapısıdır; aylık erişim $11 olarak planlanır, Federasyon katılımcı kaydı ücretsizdir.", "clubs": "Yetkili kulüp standardı ayda $30 karşılığında 12 adet iki saatlik antrenmandır; kulüp üyeliği tam resmi kurallara erişim sağlar.", "leagues": "Premier League, High League ve Super National League kulüp yarışmalarından ulusal ve gelecekteki uluslararası şampiyonalara uzanan profesyonel yolu oluşturur.", "career": "Başarı, kulüp sporcusundan şampiyonluğa, sonra liderlik, bölgesel gelişim ve Federasyon yapısına katılım fırsatlarına uzanabilir.", "international": "Uzun vadeli hedef, yetkili bölgesel kulüpleri, ulusal sistemleri, profesyonel ligleri ve yeni ülkelerdeki uluslararası yarışmaları ortak standartla geliştirmektir.", "franchise": "Franchise sistemi yetkili kulüp gelişiminin ticari altyapısıdır ve onaylı ortaklar belirlenen bölgede Federasyon standartları ve marka kurallarıyla çalışır.", "rewards": "Referans sistemi yalnız gerçek ücretli faaliyeti ödüllendirir: şartlara göre Video Game ayı için $2, kulüp ayı için $3 ve uygun franchise için %10.", "education": "Okullar, kolejler ve üniversiteler dijital sözleşme ve gerekli eğitim makamı şartlarıyla ücretsiz ticari olmayan eğitim yapabilir; ücretli faaliyetler Federasyon izni gerektirir.", "social": "DOSBALL spor, aile, toplum, eğitim, kamu kurumları ve sorumlu iş dünyasını Fair Play, Unity ve Progress ile birleştirir.", "logos": "Güncel onaylı iki DOSBALL logosu eşit görsel ölçekte gösterilir ve eski logo sürümlerinin yerini almalıdır.", "brand": "DOSBALL ad ve logolarının izinsiz kopyalanması, taklit edilmesi, değiştirilmesi, sahte üretimi veya satışı ihlalin olduğu ülkenin fikri mülkiyet hukukuna göre takip edilebilir.", "paid": "Federasyon izni olmadan ücretli DOSBALL bölümü veya ticari faaliyet yürütülemez; hukuki işlemler ilgili ülkenin uygulanabilir hukuku ve yetkili makamları/mahkemeleri üzerinden yapılır.", "gambling": "DOSBALL’un spor bahisleri, para bahisleri, bookmaker faaliyetleri, kumar, piyango veya benzeri şans oyunlarında kullanılması kesinlikle yasaktır.", "history": "DOSBALL 2006’da başladı, 2008 ve 2013 kayıt aşamalarından geçti ve spor, dijital, kulüpler, ligler, eğitim ve uluslararası organizasyona genişledi.", "author": "Askar Jambulatov, DOSBALL Super Sport International’ın kurucusu ve mucididir; amacı nesilleri, kulüpleri ve ülkeleri bağlayan kalıcı bir spor sistemi kurmaktır.", "contact": "Sporcular, kulüpler, eğitim kurumları, ortaklar, yatırımcılar ve gelecekteki bölgesel temsilcilerden ciddi başvurular memnuniyetle karşılanır."}, "ko": {"hero": "새로운 국제 팀 스포츠로서 실제 경기, 클럽, 프로 리그, 디지털 게임, 선수 성장, 교육, 프랜차이즈와 국제 연맹 발전을 하나의 생태계로 연결합니다.", "video": "DOSBALL의 분위기와 규모, 미래 방향을 가장 빠르게 느끼려면 공식 홍보 영상부터 보십시오.", "about": "DOSBALL은 2006년에 구상되었으며 속도, 조정력, 힘, 정확성, 전술적 움직임과 팀 책임을 하나의 경쟁 정체성으로 결합합니다.", "sport": "두 팀이 농구 코트 규모의 경기장에서 독특한 3링 득점 체계로 경쟁하며 운동화 구간과 롤러스케이트 구간이 신체·전술 요구를 바꿉니다.", "how": "공개 사이트는 기본 개념만 설명하며 전체 공식 규칙은 공개하지 않습니다. 전체 규칙은 공인 DOSBALL 클럽 회원이 된 선수에게만 제공합니다.", "diff": "DOSBALL은 기존 종목의 복제가 아니라 익숙한 운동 능력을 새로운 경쟁 구조에 결합한 독창적인 선수·관중 경험입니다.", "gallery": "하나의 스포츠, 하나의 연맹, 하나의 시각적 이야기로 gallery와 videos 폴더의 콘텐츠를 자동 표시합니다.", "game": "DOSBALL Video Game은 디지털 입구이며 월 $11 이용을 계획하고 연맹 참가자 등록은 무료입니다.", "clubs": "공인 클럽의 표준은 월 $30에 2시간씩 12회 훈련이며, 클럽 회원은 전체 공식 규칙에 접근할 수 있습니다.", "leagues": "Premier League, High League, Super National League가 클럽 경기에서 국내 및 미래 국제 챔피언십으로 이어지는 프로 경로를 만듭니다.", "career": "성공한 선수는 클럽 선수에서 챔피언으로, 이후 리더십·지역 개발·연맹 구조 참여 기회로 발전할 수 있습니다.", "international": "장기 목표는 공인 지역 클럽, 국가 시스템, 프로 리그와 새로운 국가의 국제대회를 하나의 기준 아래 성장시키는 것입니다.", "franchise": "프랜차이즈는 공인 클럽 개발의 사업 기반이며 승인된 파트너가 합의된 지역에서 연맹 기준과 브랜드 규칙으로 운영합니다.", "rewards": "추천 제도는 실제 유료 활동만 보상하며 조건에 따라 Video Game 월 $2, 클럽 월 $3, 적격 프랜차이즈 10%가 적용될 수 있습니다.", "education": "학교와 대학 등은 디지털 계약 및 필요한 교육 당국 요건을 충족하면 무료 비상업 교육을 할 수 있으며 유료 활동은 연맹 승인이 필요합니다.", "social": "DOSBALL은 Fair Play, Unity, Progress를 통해 스포츠, 가족, 사회, 교육, 공공기관과 책임 있는 비즈니스를 연결합니다.", "logos": "현재 승인된 두 DOSBALL 로고를 동일한 시각 크기로 표시하며 앞으로 이전 로고를 대체합니다.", "brand": "DOSBALL 명칭과 로고의 무단 복제, 모방, 변경, 위조, 제조 또는 판매는 발생 국가의 지식재산법에 따라 법적 대응 대상이 될 수 있습니다.", "paid": "연맹 승인 없는 유료 DOSBALL 과정이나 상업 활동은 허용되지 않으며 법적 조치는 해당 국가 법률과 관할 기관/법원을 통해 진행됩니다.", "gambling": "DOSBALL을 스포츠 베팅, 금전 내기, 북메이커, 도박, 복권 또는 유사한 금전성 확률 게임에 사용하는 것을 엄격히 금지합니다.", "history": "DOSBALL은 2006년에 시작되어 2008년과 2013년 등록 단계를 거쳤고 스포츠, 디지털, 클럽, 리그, 교육과 국제 조직으로 확장되었습니다.", "author": "Askar Jambulatov는 DOSBALL Super Sport International의 창립자이자 발명자로, 세대·클럽·국가를 연결하는 장기 스포츠 시스템을 목표로 합니다.", "contact": "선수, 클럽, 교육기관, 파트너, 투자자와 미래 지역 대표의 공식 참여 및 국제 개발 문의를 환영합니다."}, "ar": {"hero": "رياضة جماعية دولية جديدة تربط المنافسات الواقعية والأندية والدوريات الاحترافية واللعبة الرقمية وتطوير الرياضيين والتعليم والامتيازات ونمو الاتحاد الدولي في منظومة واحدة.", "video": "ابدأ بالفيديو الترويجي الرسمي لتشعر بأجواء DOSBALL وحجم المشروع واتجاهه المستقبلي بسرعة.", "about": "بدأت فكرة DOSBALL عام 2006 لتجمع السرعة والتنسيق والقوة والدقة والحركة التكتيكية ومسؤولية الفريق في هوية رياضية واحدة.", "sport": "يتنافس فريقان على ملعب بحجم ملعب كرة السلة بنظام تسجيل مميز يعتمد ثلاث حلقات، وتتغير المتطلبات البدنية والتكتيكية بين فترات بالأحذية الرياضية وفترة بالتزلج.", "how": "يعرض الموقع العام المفهوم الأساسي فقط، ولا تُنشر القواعد الرسمية الكاملة. يحصل عليها فقط الرياضيون بعد عضويتهم في نادٍ معتمد لـ DOSBALL.", "diff": "DOSBALL ليست نسخة من رياضة أخرى، بل تجربة مستقلة للرياضي والمشاهد تستخدم مهارات مألوفة داخل نظام تنافسي جديد.", "gallery": "رياضة واحدة واتحاد واحد وقصة بصرية واحدة؛ يتم تحميل مواد مجلدي gallery وvideos تلقائياً.", "game": "DOSBALL Video Game هي المدخل الرقمي؛ الاشتراك المخطط $11 شهرياً وتسجيل المشارك في الاتحاد مجاني.", "clubs": "النادي المعتمد بنموذجه القياسي $30 شهرياً مقابل 12 حصة، مدة كل منها ساعتان، وعضوية النادي تمنح الوصول إلى القواعد الرسمية الكاملة.", "leagues": "يشكل Premier League وHigh League وSuper National League المسار الاحترافي من منافسات الأندية إلى البطولات الوطنية والدولية المستقبلية.", "career": "قد يقود النجاح الرياضي من لاعب النادي إلى بطل ثم إلى فرص القيادة والتطوير الإقليمي والمشاركة في هيكل الاتحاد.", "international": "الهدف طويل المدى هو تطوير أندية إقليمية معتمدة وأنظمة وطنية ودوريات احترافية ومسابقات دولية في دول جديدة وفق معيار موحد.", "franchise": "نظام الامتياز هو البنية التجارية لتطوير الأندية المعتمدة، ويعمل الشريك الموافق عليه في منطقة متفق عليها وفق معايير الاتحاد وقواعد العلامة.", "rewards": "يكافئ نظام الإحالة النشاط المدفوع الحقيقي فقط: وفق الشروط $2 لشهر Video Game، و$3 لشهر النادي، و10% لامتياز مؤهل.", "education": "يمكن للمدارس والكليات والجامعات تقديم تعليم مجاني غير تجاري بعد اتفاق رقمي والالتزام بمتطلبات جهة التعليم المختصة؛ النشاط المدفوع يحتاج إلى موافقة الاتحاد.", "social": "تربط DOSBALL الرياضة والأسرة والمجتمع والتعليم والمؤسسات العامة والأعمال المسؤولة ضمن Fair Play وUnity وProgress.", "logos": "يتم عرض الشعارين الحاليين المعتمدين لـ DOSBALL بالحجم البصري نفسه ليحلا محل الإصدارات القديمة.", "brand": "قد تُلاحق قانونياً عمليات النسخ أو التقليد أو التعديل أو التزوير أو التصنيع أو البيع غير المصرح به لعلامات DOSBALL وفق قوانين الملكية الفكرية في بلد المخالفة.", "paid": "لا يجوز تشغيل أقسام أو نشاط DOSBALL مدفوع دون موافقة الاتحاد، وتتم الإجراءات القانونية وفق قانون الدولة والجهات المختصة أو المحاكم فيها.", "gambling": "يُحظر حظراً صارماً استخدام DOSBALL في المراهنات الرياضية أو الرهانات المالية أو أعمال المراهنات أو القمار أو اليانصيب أو ألعاب الحظ المالية المشابهة.", "history": "بدأت DOSBALL عام 2006 ومرت بمراحل تسجيل في 2008 و2013، ثم توسعت إلى الرياضة والرقمنة والأندية والدوريات والتعليم والتنظيم الدولي.", "author": "Askar Jambulatov هو مؤسس ومبتكر DOSBALL Super Sport International، ويهدف إلى بناء نظام رياضي طويل الأمد يربط الأجيال والأندية والدول.", "contact": "نرحب بالاستفسارات الجادة من الرياضيين والأندية والمؤسسات التعليمية والشركاء والمستثمرين والممثلين الإقليميين المستقبليين."}};const B=[...document.querySelectorAll('[data-lang]')];function setLang(l){if(!COPY[l])l='en';document.documentElement.lang=l;document.documentElement.dir=l==='ar'?'rtl':'ltr';document.querySelectorAll('[data-t]').forEach(e=>{let k=e.dataset.t;if(COPY[l][k]!=null)e.textContent=COPY[l][k]});B.forEach(b=>b.classList.toggle('active',b.dataset.lang===l));localStorage.setItem('dosballLang',l)}B.forEach(b=>b.onclick=()=>setLang(b.dataset.lang));let s=localStorage.getItem('dosballLang'),n=(navigator.language||'en').toLowerCase();setLang(s||(n.startsWith('ru')?'ru':n.startsWith('ja')?'ja':n.startsWith('zh')?'zh':n.startsWith('tr')?'tr':n.startsWith('ko')?'ko':n.startsWith('ar')?'ar':'en'));
(function(){let g=document.getElementById('galleryGrid'),x=['jpg','jpeg','png','webp'];for(let n=1;n<=60;n++){let q=String(n).padStart(2,'0'),im=document.createElement('img'),i=0;im.loading='lazy';im.alt='DOSBALL gallery '+q;function nx(){if(i>=x.length){im.remove();return}im.src='gallery/photo'+q+'.'+x[i++]}im.onerror=nx;g.appendChild(im);nx()}})();(function(){let g=document.getElementById('videoGrid');for(let n=1;n<=20;n++){let q=String(n).padStart(2,'0'),v=document.createElement('video'),s=document.createElement('source');v.controls=true;v.preload='metadata';v.playsInline=true;s.src='videos/video'+q+'.mp4';s.type='video/mp4';s.onerror=()=>v.remove();v.appendChild(s);g.appendChild(v)}})();</script></body></html>