<!DOCTYPE html>
<!-- DOSBALL MASTER PHOTO & INDEX FINAL CODE 7 • 2026 • ULTIMATE FINAL • Two approved new logos only -->
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>DOSBALL Super Sport International</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth}
body{font-family:Arial,Helvetica,sans-serif;background:#07111f;color:#fff;line-height:1.6}
nav{position:sticky;top:0;z-index:1000;background:rgba(5,16,28,.97);padding:10px;text-align:center;border-bottom:1px solid #1f425c}
nav a{color:#fff;text-decoration:none;margin:6px 8px;display:inline-block;font-size:14px}nav a:hover{color:#ffd447}
.language-bar{background:#03090f;padding:12px 10px;text-align:center;border-bottom:1px solid #244960}
.language-bar span{margin-right:10px;font-weight:bold;color:#ffd447}
.lang-btn{border:1px solid #fff;background:#fff;color:#07111f;padding:8px 12px;margin:4px;border-radius:20px;cursor:pointer;font-size:14px;font-weight:bold}
.lang-btn:hover,.lang-btn.active{background:#ffd447;color:#07111f;border-color:#ffd447}
header{background:linear-gradient(135deg,#07111f,#0c3150);padding:80px 20px;text-align:center}
header h1{font-size:clamp(38px,8vw,76px);color:#ffd447;margin-bottom:5px;letter-spacing:2px}
header h2{font-size:clamp(20px,4vw,34px);margin-bottom:20px}
header p{max-width:900px;margin:auto;font-size:18px;color:#d5e4ee}
.hero-buttons{margin-top:30px;display:flex;justify-content:center;gap:15px;flex-wrap:wrap}
.btn{display:inline-block;padding:14px 24px;border-radius:30px;background:#fff;color:#07111f;text-decoration:none;font-weight:bold;transition:.3s;border:2px solid #fff;cursor:pointer}
.btn:hover{transform:translateY(-2px);background:#ffd447;border-color:#ffd447}
section{padding:70px 20px}.container{width:min(1150px,100%);margin:auto}
h2.section-title{text-align:center;color:#ffd447;font-size:clamp(28px,5vw,42px);margin-bottom:15px}
.section-intro{text-align:center;max-width:900px;margin:0 auto 40px;color:#c6d7e3}
.light-section{background:#0d1c2d}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px}
.card{background:#10283e;border:1px solid #21415b;border-radius:18px;padding:24px}
.card h3{color:#ffd447;margin-bottom:10px}.card p{color:#d6e3eb}
.highlight{color:#ffd447;font-weight:bold}
.video-wrapper{max-width:900px;margin:30px auto;position:relative;padding-bottom:56.25%;height:0;overflow:hidden;border-radius:18px;background:#000;box-shadow:0 15px 50px rgba(0,0,0,.4)}
.video-wrapper iframe{position:absolute;width:100%;height:100%;top:0;left:0;border:0}
.price-box{max-width:500px;margin:25px auto;background:linear-gradient(135deg,#15384e,#0a1928);padding:35px;border-radius:22px;text-align:center;border:2px solid #ffd447}
.price{font-size:52px;color:#ffd447;font-weight:bold}.small{font-size:14px;color:#aac0ce}
.franchise{background:linear-gradient(135deg,#0c2438,#153b4c)}
.notice{max-width:900px;margin:25px auto;padding:20px;background:#162c3d;border-left:5px solid #ffd447;border-radius:10px}
.featured-video-label{text-align:center;color:#ffd447;font-weight:bold;margin-top:8px}
.media-grid,.link-video-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px;margin-top:24px}
.media-card{background:#0a1724;border:1px solid #244960;border-radius:18px;overflow:hidden;display:none}
.media-card.ready{display:block}.media-card video{display:block;width:100%;aspect-ratio:16/9;background:#000;object-fit:contain}.media-card p{padding:12px 15px;color:#c6d7e3}
.link-video-card{background:#0a1724;border:1px solid #244960;border-radius:18px;overflow:hidden}
.link-video-card iframe{display:block;width:100%;aspect-ratio:16/9;border:0;background:#000}
.link-video-card h3{color:#ffd447;padding:14px 15px 4px}.link-video-card p{padding:0 15px 14px;color:#a9c0cf;font-size:14px}
.video-link-slot{border:1px dashed #45677e;border-radius:16px;padding:18px;text-align:center;color:#9fb3c1;background:#081827}
.video-link-slot strong{display:block;color:#ffd447;margin-bottom:5px}
.gallery-auto{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:14px;margin-top:24px}
.gallery-photo{display:none;background:#06101a;border:1px solid #244960;border-radius:16px;overflow:hidden;min-height:170px}
.gallery-photo.ready{display:block}.gallery-photo img{display:block;width:100%;height:230px;object-fit:cover}.gallery-photo figcaption{padding:10px 12px;color:#c6d7e3;font-size:14px}
.upload-guide{max-width:950px;margin:24px auto 0;background:#0b2233;border:1px dashed #ffd447;border-radius:14px;padding:18px;text-align:center;color:#d6e3eb}
.social-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:15px;max-width:1100px;margin:auto}
.social-link{display:block;background:#10283e;color:#fff;text-decoration:none;padding:18px;text-align:center;border-radius:14px;border:1px solid #244960}
.social-link:hover{color:#ffd447;border-color:#ffd447}.social-link.disabled{opacity:.55;cursor:default}
.social-icon{display:block;font-size:22px;margin-bottom:5px}.social-handle{display:block;font-size:12px;color:#9fb3c1;margin-top:4px}
form{max-width:700px;margin:30px auto;background:#10283e;padding:30px;border-radius:20px}
form label{display:block;margin-bottom:7px;color:#ffd447}
form input,form select,form textarea{width:100%;padding:13px;margin-bottom:18px;border-radius:9px;border:1px solid #315068;background:#07111f;color:#fff}
form button{width:100%;font-size:16px}
.payment-ready{max-width:950px;margin:30px auto;background:#081827;border:2px dashed #ffd447;border-radius:20px;padding:28px;text-align:center}
.payment-ready h3{color:#ffd447;margin-bottom:10px}.payment-ready code{display:block;margin-top:14px;color:#b9d4e5;word-break:break-word}
.contact-card{max-width:900px;margin:28px auto;background:#10283e;border:1px solid #244960;border-radius:20px;padding:28px;text-align:left}
.contact-card h3{color:#ffd447;margin-bottom:16px}.contact-card p{margin:8px 0;color:#d6e3eb}.contact-card a{color:#ffd447;text-decoration:none;word-break:break-word}
footer{padding:45px 20px;text-align:center;background:#03090f;color:#9fb3c1}footer strong{color:#ffd447}
[dir="rtl"] body{text-align:right}[dir="rtl"] nav,[dir="rtl"] .language-bar,[dir="rtl"] header,[dir="rtl"] footer{text-align:center}
[dir="rtl"] .cards,[dir="rtl"] .social-grid,[dir="rtl"] .media-grid,[dir="rtl"] .gallery-auto{direction:rtl}

.brand-lockup{display:flex;justify-content:center;align-items:center;gap:28px;flex-wrap:wrap;margin:0 auto 28px;max-width:920px}
.brand-logo{display:block;object-fit:contain;filter:drop-shadow(0 14px 28px rgba(0,0,0,.48))}
.brand-logo.main{width:min(390px,78vw);max-height:390px}
.brand-logo.federation{width:min(245px,52vw);max-height:245px}
.brand-note{text-align:center;color:#d5e4ee;font-size:13px;letter-spacing:.6px;margin-top:10px}

@media(max-width:600px){header{padding:55px 18px}section{padding:50px 16px}nav{position:relative}.language-bar span{display:block;margin:0 0 6px}}
</style>
</head>
<body>

<div class="language-bar">
<span data-i18n="language">Language:</span>
<button class="lang-btn active" data-lang="en">🇬🇧 English</button>
<button class="lang-btn" data-lang="ru">🇷🇺 Русский</button>
<button class="lang-btn" data-lang="ja">🇯🇵 日本語</button>
<button class="lang-btn" data-lang="zh">🇨🇳 中文</button>
<button class="lang-btn" data-lang="tr">🇹🇷 Türkçe</button>
<button class="lang-btn" data-lang="ko">🇰🇷 한국어</button>
<button class="lang-btn" data-lang="ar">🇸🇦 العربية</button>
</div>

<nav>
<a href="#about" data-i18n="navAbout">About</a>
<a href="#rules" data-i18n="navSport">Sport</a>
<a href="#video" data-i18n="navVideo">Video</a>
<a href="#gallery" data-i18n="navGallery">Gallery</a>
<a href="#testimonials" data-i18n="navTestimonials">Testimonials</a>
<a href="#game" data-i18n="navGame">Video Game</a>
<a href="#clubs" data-i18n="navClubs">Clubs</a>
<a href="#leagues" data-i18n="navLeagues">Leagues</a>
<a href="#franchise" data-i18n="navFranchise">Franchise</a>
<a href="#referral" data-i18n="navRewards">Rewards</a>
<a href="#education" data-i18n="navEducation">Education</a>
<a href="#social" data-i18n="navSocial">Social Media</a>
<a href="#register" data-i18n="navRegister">Registration</a>
</nav>

<header>
<div class="brand-lockup" aria-label="Official DOSBALL branding">
<img class="brand-logo main" src="data:image/webp;base64," alt="DOSBALL Super Sport International official logo">
<img class="brand-logo federation" src="data:image/webp;base64," alt="DOSBALL Super Sport Federation official emblem">
</div>
<h1>DOSBALL</h1>
<h2>SUPER SPORT INTERNATIONAL</h2>
<p data-i18n="heroText">A new international sport ecosystem bringing together Sport, Society, State and Business for the benefit of society.</p>
<div class="hero-buttons">
<a class="btn" href="#register" data-i18n="registerFree">Register Free</a>
<a class="btn" href="#video" data-i18n="watchDosball">Watch DOSBALL</a>
</div>
</header>

<section id="about"><div class="container">
<h2 class="section-title" data-i18n="welcomeTitle">Welcome to DOSBALL</h2>
<p class="section-intro" data-i18n="welcomeIntro">DOSBALL is an innovative international Super Sport created as a new sports discipline and global ecosystem combining athletic competition, video gaming, clubs, professional leagues, education and international development.</p>
<div class="cards">
<div class="card"><h3 data-i18n="newSportTitle">New Sport</h3><p data-i18n="newSportText">DOSBALL combines dynamic elements inspired by basketball, volleyball, handball, rugby and football into a new competitive sport.</p></div>
<div class="card"><h3 data-i18n="federationTitle">International Federation</h3><p data-i18n="federationText">The DOSBALL Federation develops official rules, clubs, tournaments, championships and international cooperation.</p></div>
<div class="card"><h3 data-i18n="digitalTitle">Digital Ecosystem</h3><p data-i18n="digitalText">DOSBALL connects the physical sport with a video game, memberships, referrals, digital registration and future online services.</p></div>
<div class="card"><h3 data-i18n="missionTitle">Global Mission</h3><p data-i18n="missionText">The long-term mission is to develop DOSBALL worldwide, build professional leagues and work toward international recognition.</p></div>
</div></div></section>

<section id="rules" class="light-section"><div class="container">
<h2 class="section-title" data-i18n="sportTitle">DOSBALL Sport</h2>
<p class="section-intro" data-i18n="sportIntro">Fast, energetic and designed for international competition.</p>
<div class="cards">
<div class="card"><h3 data-i18n="teamsTitle">Teams</h3><p data-i18n="teamsText">6 athletes play on the court with fast substitutions.</p></div>
<div class="card"><h3 data-i18n="matchTitle">Match</h3><p data-i18n="matchText">Three periods of 20 minutes of clean playing time.</p></div>
<div class="card"><h3 data-i18n="scoringTitle">Scoring</h3><p data-i18n="scoringText">A fist strike through the ring scores 2 points. A hand throw through the ring scores 1 point.</p></div>
<div class="card"><h3 data-i18n="ringsTitle">Three Rings</h3><p data-i18n="ringsText">Each side of the court uses three vertical DOSBALL rings.</p></div>
</div></div></section>

<section id="video"><div class="container">
<h2 class="section-title" data-i18n="videoTitle">Official DOSBALL Video</h2>
<p class="section-intro" data-i18n="videoIntro">Watch the DOSBALL Super Sport concept in action.</p>
<div class="featured-video-label" data-i18n="featuredVideoTitle">Featured DOSBALL Video</div>
<div class="video-wrapper"><iframe src="https://www.youtube.com/embed/AxgTkmCzCDU" title="DOSBALL Super Sport International" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>
<h2 class="section-title" style="font-size:28px;margin-top:45px">YouTube / Shorts</h2>
<div id="youtubeVideoGrid" class="link-video-grid"></div>
<h2 class="section-title" style="font-size:28px;margin-top:45px" data-i18n="videoLibraryTitle">DOSBALL Video Library</h2>
<p class="section-intro" data-i18n="videoLibraryIntro">Upload files named video01.mp4, video02.mp4 and so on into the videos folder. Available videos appear automatically; missing files stay hidden.</p>
<div id="autoVideoGrid" class="media-grid"></div>
<div class="upload-guide"><strong>FINAL VIDEO SYSTEM:</strong><br>GitHub: <b>videos/video01.mp4 … video20.mp4</b> • YouTube links: edit <b>youtubeVideoLinks</b> near the end of this file.</div>
</div></section>

<section id="gallery" class="light-section"><div class="container">
<h2 class="section-title" data-i18n="galleryTitle">DOSBALL Gallery</h2>
<p class="section-intro" data-i18n="galleryIntro">One unified DOSBALL gallery for all official sport photos — athletes, uniforms, teams, training, clubs, competitions and Federation events.</p>
<div id="autoGallery" class="gallery-auto"></div>
<div class="upload-guide"><strong data-i18n="galleryHint">ONE SPORT • ONE FEDERATION • ONE GALLERY.</strong><br><span data-i18n="galleryUpload">Add numbered images to <b>gallery/photo01.jpg … photo60.jpg</b> (also .jpeg, .png, .webp). No category editing is required.</span></div>
</div></section>

<section id="testimonials"><div class="container">
<h2 class="section-title" data-i18n="testimonialTitle">Video Testimonials</h2>
<p class="section-intro" data-i18n="testimonialIntro">Athletes, coaches, club owners, supporters and partners can share their experience with DOSBALL through video testimonials.</p>
<div id="testimonialVideoGrid" class="link-video-grid"></div>
<div class="upload-guide"><strong>TESTIMONIAL LINKS READY.</strong><br>Add YouTube / Shorts links in <b>testimonialVideoLinks</b>.</div>
</div></section>

<section id="game" class="light-section"><div class="container">
<h2 class="section-title" data-i18n="gameTitle">DOSBALL Video Game</h2>
<p class="section-intro" data-i18n="gameIntro">The DOSBALL digital ecosystem begins with the official video game.</p>
<div class="price-box">
<div data-i18n="monthlyAccess">Monthly Video Game Access</div>
<div class="price">$11</div>
<p data-i18n="perMonth">per month</p><br>
<p><span data-i18n="registrationText">Registration in the DOSBALL ecosystem is</span> <span class="highlight" data-i18n="freeText">FREE</span>.</p><br>
<p data-i18n="gamePaymentText">Access to the DOSBALL video game requires an active $11 monthly subscription.</p>
</div>
<div class="notice" data-i18n="referralNotice">Referral links remain active while the user's monthly $11 video game subscription is active. If the next monthly payment is not made, the referral link is frozen. After payment is renewed, the referral link becomes active again for the paid monthly period.</div>
</div></section>

<section id="clubs"><div class="container">
<h2 class="section-title" data-i18n="clubsTitle">DOSBALL Clubs</h2>
<p class="section-intro" data-i18n="clubsIntro">DOSBALL clubs provide official training, athlete development, competitions and community participation.</p>
<div class="cards">
<div class="card"><h3 data-i18n="clubTrainingTitle">Club Training</h3><p data-i18n="clubTrainingText">Official DOSBALL training programs can be organized by licensed clubs.</p></div>
<div class="card"><h3 data-i18n="coachesTitle">Coaches</h3><p data-i18n="coachesText">Coaches participate in athlete development and DOSBALL training standards.</p></div>
<div class="card"><h3 data-i18n="competitionPathTitle">Competition Path</h3><p data-i18n="competitionPathText">Athletes can progress from clubs to championships and professional DOSBALL leagues.</p></div>
</div></div></section>

<section id="leagues" class="light-section"><div class="container">
<h2 class="section-title" data-i18n="leaguesTitle">Professional Leagues</h2>
<div class="cards">
<div class="card"><h3>Premier League</h3><p data-i18n="premierText">Professional DOSBALL competition.</p></div>
<div class="card"><h3>High League</h3><p data-i18n="highText">High-level DOSBALL championship competition.</p></div>
<div class="card"><h3>Super National League</h3><p data-i18n="superNationalText">Top national and international DOSBALL competition.</p></div>
</div></div></section>

<section id="franchise" class="franchise"><div class="container">
<h2 class="section-title" data-i18n="franchiseTitle">DOSBALL Franchise</h2>
<p class="section-intro" data-i18n="franchiseIntro">Become an official DOSBALL club operator and develop the sport in your city, region or country.</p>
<div class="cards">
<div class="card"><h3 data-i18n="licenseTitle">Official Club License</h3><p data-i18n="licenseText">Franchisees receive the right to operate an authorized DOSBALL club according to Federation standards and the active franchise agreement.</p></div>
<div class="card"><h3 data-i18n="franchisePaymentTitle">Franchise Payment</h3><p data-i18n="franchisePaymentText">Franchise payments are handled separately from the $11 monthly video game subscription.</p></div>
<div class="card"><h3 data-i18n="licenseStatusTitle">License Status</h3><p data-i18n="licenseStatusText">When the franchise license expires, the club may not continue official paid DOSBALL club training until the license is renewed.</p></div>
<div class="card"><h3 data-i18n="expansionTitle">Expansion</h3><p data-i18n="expansionText">Successful operators may qualify for expanded DOSBALL club opportunities according to Federation agreements.</p></div>
</div></div></section>

<section id="referral"><div class="container">
<h2 class="section-title" data-i18n="referralTitle">Referral & Rewards</h2>
<p class="section-intro" data-i18n="referralIntro">Registered Federation members can receive direct referral rewards from eligible invited users according to official DOSBALL program conditions.</p>
<div class="cards">
<div class="card"><h3 data-i18n="videoReferralTitle">Video Game Referral — $2 Monthly</h3><p data-i18n="videoReferralText">For each directly invited active paying DOSBALL Video Game subscriber, the inviter receives $2 for every paid month of the invited user's active $11 monthly subscription.</p></div>
<div class="card"><h3 data-i18n="clubReferralTitle">DOSBALL Club Referral — $3 Monthly</h3><p data-i18n="clubReferralText">If a directly invited member joins a DOSBALL Club and pays $30 per month for 12 two-hour training sessions, the inviter receives $3 for each paid month for as long as that invited member continues paid club training.</p></div>
<div class="card"><h3 data-i18n="franchiseReferralTitle">Franchise Referral — 10%</h3><p data-i18n="franchiseReferralText">When an eligible directly invited member purchases an official DOSBALL Federation franchise, the inviter receives 10% of the qualifying franchise payment according to the official franchise agreement.</p></div>
<div class="card"><h3 data-i18n="transparentRewardsTitle">Transparent Rewards</h3><p data-i18n="transparentRewardsText">Eligible rewards should be recorded and paid transparently, on time and in full through the DOSBALL Federation's official digital system.</p></div>
</div></div></section>

<section id="education" class="light-section"><div class="container">
<h2 class="section-title" data-i18n="educationTitle">Schools, Colleges & Universities</h2>
<p class="section-intro" data-i18n="educationIntro">DOSBALL supports cooperation with educational institutions around the world.</p>
<div class="notice" data-i18n="educationPolicy"><strong>Educational Use Policy</strong><br><br>General education schools, colleges, universities and other educational institutions under the authority of any state or country may use the official DOSBALL game rules free of charge after entering into a digital agreement with the DOSBALL Federation.<br><br>The agreement may be concluded for an indefinite term for educational and non-commercial use.<br><br>Educational institutions receiving this free right may use DOSBALL within physical education classes, educational programs and approved non-commercial activities.<br><br>This free educational right does not grant the institution the right to independently organize paid DOSBALL sections, paid commercial training programs, sell DOSBALL franchises or sublicense DOSBALL intellectual property.<br><br>Commercial DOSBALL sections and paid official training programs may only be organized by the DOSBALL Federation or by persons and organizations specifically authorized by the Federation.</div>
</div></section>

<section id="charity"><div class="container">
<h2 class="section-title" data-i18n="charityTitle">Social Responsibility</h2>
<p class="section-intro" data-i18n="charityIntro">DOSBALL is designed not only as a sport and business ecosystem, but also as a platform for positive social development.</p>
<div class="cards">
<div class="card"><h3 data-i18n="familiesTitle">Families</h3><p data-i18n="familiesText">Social programs may support athletes and their families.</p></div>
<div class="card"><h3 data-i18n="youthTitle">Youth</h3><p data-i18n="youthText">DOSBALL promotes healthy activity, discipline and teamwork.</p></div>
<div class="card"><h3 data-i18n="communityTitle">Community</h3><p data-i18n="communityText">Federation projects may cooperate with charitable and social organizations.</p></div>
</div></div></section>

<section id="integrity" class="light-section"><div class="container">
<h2 class="section-title" data-i18n="integrityTitle">Sport Integrity</h2>
<div class="notice" data-i18n="integrityText">DOSBALL must never be used for sports betting, gambling, wagering, lotteries or gambling-related activities.<br><br>The DOSBALL ecosystem is intended for sport, education, healthy competition, community development and legitimate business activity.</div>
</div></section>

<section id="social"><div class="container">
<h2 class="section-title" data-i18n="socialTitle">Follow DOSBALL</h2>
<p class="section-intro" data-i18n="socialIntro">Connect with DOSBALL Super Sport International through social media.</p>
<div class="social-grid">
<a class="social-link" href="https://youtube.com/@askarjan777" target="_blank" rel="noopener noreferrer"><span class="social-icon">▶️</span>YouTube<span class="social-handle">@askarjan777</span></a>
<a class="social-link disabled" href="#" onclick="return false"><span class="social-icon">📸</span>Instagram<span class="social-handle" data-i18n="comingSoon">Coming soon</span></a>
<a class="social-link disabled" href="#" onclick="return false"><span class="social-icon">📘</span>Facebook<span class="social-handle" data-i18n="comingSoon">Coming soon</span></a>
<a class="social-link disabled" href="#" onclick="return false"><span class="social-icon">🎵</span>TikTok<span class="social-handle" data-i18n="comingSoon">Coming soon</span></a>
<a class="social-link disabled" href="#" onclick="return false"><span class="social-icon">💼</span>LinkedIn<span class="social-handle" data-i18n="comingSoon">Coming soon</span></a>
<a class="social-link disabled" href="#" onclick="return false"><span class="social-icon">𝕏</span>X / Twitter<span class="social-handle" data-i18n="comingSoon">Coming soon</span></a>
<a class="social-link disabled" href="#" onclick="return false"><span class="social-icon">✈️</span>Telegram<span class="social-handle" data-i18n="comingSoon">Coming soon</span></a>
<a class="social-link disabled" href="#" onclick="return false"><span class="social-icon">💬</span>WhatsApp<span class="social-handle" data-i18n="comingSoon">Coming soon</span></a>
</div></div></section>

<section id="register" class="light-section"><div class="container">
<h2 class="section-title" data-i18n="registrationTitle">Free Registration</h2>
<p class="section-intro" data-i18n="registrationIntro">Join the DOSBALL Super Sport International ecosystem. Registration is free.</p>
<form id="registrationForm">
<label for="name" data-i18n="fullName">Full Name</label><input type="text" id="name" required>
<label for="email" data-i18n="emailLabel">Email</label><input type="email" id="email" required>
<label for="country" data-i18n="countryLabel">Country</label><input type="text" id="country" required>
<label for="role" data-i18n="roleLabel">I want to join as</label>
<select id="role">
