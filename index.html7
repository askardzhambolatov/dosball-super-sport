وفي موعدها وبالكامل من خلال النظام الرقمي الرسمي لاتحاد DOSBALL.",educationTitle:"المدارس والكليات والجامعات",charityTitle:"المسؤولية الاجتماعية",integrityTitle:"نزاهة الرياضة",socialTitle:"تابع DOSBALL",registrationTitle:"التسجيل المجاني",registerButton:"سجّل مجاناً",paymentsTitle:"المدفوعات الرقمية",joinDosball:"انضم إلى DOSBALL",footerText:"الرياضة • المجتمع • الدولة • الأعمال",footerRights:"© 2026 DOSBALL Super Sport International. جميع الحقوق محفوظة."}
};

function setLanguage(lang){
 const t=translations[lang]||translations.en;
 document.documentElement.lang=lang;
 document.documentElement.dir=(lang==='ar'?'rtl':'ltr');
 document.querySelectorAll('[data-i18n]').forEach(el=>{
   const k=el.dataset.i18n;
   const value=t[k]!==undefined?t[k]:translations.en[k];
   if(value!==undefined) el.innerHTML=value;
 });
 document.querySelectorAll('.lang-btn').forEach(b=>b.classList.toggle('active',b.dataset.lang===lang));
 localStorage.setItem('dosball-language',lang);
}
document.querySelectorAll('.lang-btn').forEach(b=>b.addEventListener('click',()=>setLanguage(b.dataset.lang)));
document.addEventListener('DOMContentLoaded',()=>setLanguage(localStorage.getItem('dosball-language')||'en'));

document.getElementById('registrationForm').addEventListener('submit',e=>{
 e.preventDefault();
 const lang=localStorage.getItem('dosball-language')||'en';
 const m={
 en:'Thank you for your interest in DOSBALL. The secure registration backend will be connected in the next development stage.',
 ru:'Спасибо за интерес к DOSBALL. Защищённая система регистрации будет подключена на следующем этапе разработки.',
 ja:'DOSBALLにご関心をお寄せいただきありがとうございます。安全な登録システムは次の開発段階で接続されます。',
 zh:'感谢您对 DOSBALL 的关注。安全注册系统将在下一开发阶段连接。',
 tr:"DOSBALL'a gösterdiğiniz ilgi için teşekkür ederiz. Güvenli kayıt sistemi bir sonraki geliştirme aşamasında bağlanacaktır.",
 ko:'DOSBALL에 관심을 가져주셔서 감사합니다. 안전한 등록 백엔드는 다음 개발 단계에서 연결됩니다.',
 ar:'شكراً لاهتمامكم بـ DOSBALL. سيتم ربط نظام التسجيل الآمن في مرحلة التطوير التالية.'
 };
 alert(m[lang]||m.en);
});

(function(){
 const gallery=document.getElementById('autoGallery');
 const imageExts=['jpg','jpeg','png','webp'];
 const currentRepoPhotos=[
 "0074bfeeded556590bd96073d8c25cd8dce9977b31d0d061b9f4d896417ff734.png",
 "65f00afbad4ad6d0f5916518623e20079f574dd43580eb3fbc5024b7c7399478.png",
 "75a02f6faad78c9f09955ce912d8980b8af1abd27d86ed9c53b492f7a34f14b0.png",
 "7eaddd6aee31bc7565b3b3b898ac6f37d1b699a110f8192f6b93eff606690fbe.png",
 "862e9ebbf3cb69e0368a4c32bb74acecaa8b5757a651b0222cd7fde912b8fd00.png",
 "8ec0b3d7883d9158e12c849b3520fa98fa47c5769a5233bbc69eb3bd5d19191e.png",
 "IMG-20260630-WA0011.jpg","Screenshot_20260630_105815_Photos.jpg","Screenshot_20260630_111456_WhatsApp.jpg",
 "Screenshot_20260630_115343_WhatsApp.jpg","Screenshot_20260630_120133_WhatsApp.jpg","Screenshot_20260630_120726_WhatsApp.jpg",
 "Screenshot_20260630_120809_WhatsApp.jpg","a006a330a4efc459e20ca3d0d9d169f9aa92abb5ec8753a232cddaa4c16e96fa.png",
 "arena-gold.webp","bangkok-handoff.webp","be28c819f6549eb1c67e7c6d81f3388162c60e2f1690996a6f07078f1fd7de0f.png",
 "c951a058617a9ec94b72799c3fd55c772b5f276c6f641b78dea77a45d0952a34.png","canada-france-handoff.webp",
 "cd0bef332519a9886f6eb807e25a3c6c1e1958e0315d9f2ffa6140ed1eb71f9b.png","china-closeup.webp",
 "e3a6fa64649529b88b9f69fa6a60e3b44fe5f5b775c0ee2c4edda5f9ccd46d64.png",
 "ed5f2ad8207e247ada566d95c817a75e28d9eb9a21f92c73a1bccca15e4b2880.png","hero-arena-white.webp"
 ];
 if(gallery){
  const seen=new Set();
  const addPhoto=(src,label)=>{
    if(seen.has(src))return;seen.add(src);
    const fig=document.createElement('figure');fig.className='gallery-photo';
    const img=document.createElement('img');img.alt=label||'DOSBALL photo';img.loading='lazy';img.src=src;
    const cap=document.createElement('figcaption');cap.textContent=label||'DOSBALL';
    fig.append(img,cap);gallery.appendChild(fig);
    img.onload=()=>fig.classList.add('ready');img.onerror=()=>fig.remove();
  };
  currentRepoPhotos.forEach((name,i)=>addPhoto(name,'DOSBALL • Gallery '+String(i+1).padStart(2,'0')));
  for(let i=1;i<=60;i++){
    const num=String(i).padStart(2,'0');let e=0;
    const tryNumbered=()=>{
      if(e>=imageExts.length)return;
      const src='gallery/photo'+num+'.'+imageExts[e++];
      const probe=new Image();
      probe.onload=()=>addPhoto(src,'DOSBALL • Photo '+num);
      probe.onerror=tryNumbered;probe.src=src;
    };
    tryNumbered();
  }
 }

 const youtubeVideoLinks=[
  {title:'DOSBALL Video 01',url:'https://youtube.com/shorts/AxgTkmCzCDU'},
  {title:'DOSBALL Video 02',url:''},{title:'DOSBALL Video 03',url:''},{title:'DOSBALL Video 04',url:''},
  {title:'DOSBALL Video 05',url:''},{title:'DOSBALL Video 06',url:''},{title:'DOSBALL Video 07',url:''},
  {title:'DOSBALL Video 08',url:''},{title:'DOSBALL Video 09',url:''},{title:'DOSBALL Video 10',url:''}
 ];
 const testimonialVideoLinks=[
  {title:'Athletes',url:''},{title:'Coaches',url:''},{title:'Partners & Clubs',url:''},
  {title:'Supporters',url:''},{title:'Federation Events',url:''},{title:'International Community',url:''}
 ];
 function youtubeId(url){
  if(!url)return '';
  try{
    const u=new URL(url,location.href);
    if(u.hostname.includes('youtu.be'))return u.pathname.split('/').filter(Boolean)[0]||'';
    if(u.pathname.includes('/shorts/'))return u.pathname.split('/shorts/')[1].split('/')[0]||'';
    if(u.pathname.includes('/embed/'))return u.pathname.split('/embed/')[1].split('/')[0]||'';
    return u.searchParams.get('v')||'';
  }catch(e){return '';}
 }
 function renderLinkVideos(targetId,items){
  const grid=document.getElementById(targetId);if(!grid)return;
  items.forEach((item,i)=>{
    const id=youtubeId(item.url);
    if(id){
      const card=document.createElement('article');card.className='link-video-card';
      const frame=document.createElement('iframe');frame.src='https://www.youtube.com/embed/'+encodeURIComponent(id);
      frame.title=item.title||('DOSBALL Video '+(i+1));frame.loading='lazy';
      frame.allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';frame.allowFullscreen=true;
      const h=document.createElement('h3');h.textContent=item.title||('DOSBALL Video '+(i+1));
      const p=document.createElement('p');p.textContent='YouTube / Shorts';
      card.append(frame,h,p);grid.appendChild(card);
    }else{
      const slot=document.createElement('div');slot.className='video-link-slot';
      slot.innerHTML='<strong>'+((item.title)||('Video Link Slot '+(i+1)))+'</strong><span>Reserved place for YouTube / Shorts link</span>';
      grid.appendChild(slot);
    }
  });
 }
 renderLinkVideos('youtubeVideoGrid',youtubeVideoLinks);
 renderLinkVideos('testimonialVideoGrid',testimonialVideoLinks);

 const videoGrid=document.getElementById('autoVideoGrid');
 if(videoGrid){
  for(let i=1;i<=20;i++){
    const num=String(i).padStart(2,'0');
    const card=document.createElement('article');card.className='media-card';
    const v=document.createElement('video');v.controls=true;v.preload='metadata';v.playsInline=true;
    const p=document.createElement('p');p.textContent='DOSBALL • Video '+num;
    card.append(v,p);videoGrid.appendChild(card);
    const sources=['videos/video'+num+'.mp4','videos/video'+num+'.webm'];let s=0;
    const tryVideo=()=>{if(s>=sources.length){card.remove();return;}v.src=sources[s++];v.load();};
    v.addEventListener('loadedmetadata',()=>card.classList.add('ready'),{once:true});
    v.addEventListener('error',()=>{if(!card.classList.contains('ready'))tryVideo();});
    tryVideo();
  }
 }
})();
</script>
</body>
</html>
