<!DOCTYPE html>
<!-- DOSBALL FINAL INDEX 7 • 2026 • Unified Gallery + Gold Navigation Buttons -->
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#06111d">
<title>DOSBALL Super Sport International</title>
<style>
:root{
  --bg:#06111d;
  --bg2:#091a2b;
  --card:#0c2033;
  --gold:#f2c94c;
  --gold2:#ffdb67;
  --white:#fff;
  --muted:#b9c7d5;
  --line:#24435b;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:Arial,Helvetica,sans-serif;
  background:linear-gradient(180deg,#04101a 0%,#071522 45%,#06111d 100%);
  color:var(--white);
  line-height:1.6;
}
img{max-width:100%;display:block}
a{color:inherit}
.container{width:min(1120px,94%);margin:auto}
.section{padding:56px 0;border-top:1px solid rgba(36,67,91,.55)}
h1,h2,h3{line-height:1.15}
h2{font-size:clamp(28px,5vw,44px);text-align:center;margin-bottom:18px;color:var(--gold2)}
p{color:#eef4f8}
.small{color:var(--muted);font-size:14px}

/* LANGUAGE BAR */
.language-wrap{
  padding:26px 10px 28px;
  background:#02090f;
  border-bottom:1px solid var(--line);
  text-align:center;
}
.language-title{
  color:var(--gold2);
  font-size:26px;
  font-weight:800;
  margin-bottom:18px;
}
.language-grid{
  display:flex;
  flex-wrap:wrap;
  justify-content:center;
  gap:14px;
  max-width:720px;
  margin:auto;
}
.lang-btn{
  border:0;
  background:#fff;
  color:#0b1220;
  font-weight:800;
  border-radius:999px;
  padding:13px 20px;
  font-size:18px;
  cursor:pointer;
  min-width:145px;
  box-shadow:0 3px 10px rgba(0,0,0,.22);
}
.lang-btn.active{
  background:linear-gradient(180deg,#ffdd68,#f3c53f);
}

/* NAVIGATION */
.nav-wrap{
  position:sticky;
  top:0;
  z-index:1000;
  background:rgba(5,16,28,.97);
  backdrop-filter:blur(8px);
  border-bottom:1px solid var(--line);
  padding:14px 8px;
}
.nav-grid{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  justify-content:center;
  max-width:1080px;
  margin:auto;
}
.nav-grid a{
  text-decoration:none;
  color:#fff;
  border:1px solid var(--gold);
  border-radius:12px;
  padding:10px 15px;
  font-size:15px;
  font-weight:700;
  background:#071522;
  transition:.2s ease;
}
.nav-grid a:hover,.nav-grid a:focus{
  background:var(--gold);
  color:#07111d;
  transform:translateY(-1px);
}

/* HERO */
.hero{
  padding:42px 0 56px;
  text-align:center;
  background:
    radial-gradient(circle at 50% 15%,rgba(33,88,132,.25),transparent 38%),
    linear-gradient(180deg,#061728,#07111d);
}
.hero-logo{
  width:min(650px,94vw);
  margin:0 auto 22px;
  object-fit:contain;
  border-radius:22px;
}
.hero h1{
  font-size:clamp(34px,7vw,64px);
  letter-spacing:.5px;
  color:#fff;
}
.hero .tagline{
  color:var(--gold2);
  font-weight:800;
  margin:12px auto 0;
  font-size:clamp(18px,3vw,25px);
}

/* CARDS */
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px}
.card{
  background:linear-gradient(180deg,#0b2033,#081827);
  border:1px solid #244b68;
  border-radius:18px;
  padding:22px;
  box-shadow:0 10px 25px rgba(0,0,0,.2);
}
.card h3{color:var(--gold2);font-size:21px;margin-bottom:10px}
.big-number{font-size:34px;font-weight:900;color:var(--gold2)}
.note{
  border-left:3px solid var(--gold);
  background:#0a1b2b;
  padding:16px 18px;
  border-radius:10px;
  color:#d9e5ef;
}

/* VIDEO */
.video-frame{
  width:min(850px,100%);
  aspect-ratio:16/9;
  margin:22px auto 0;
  border-radius:18px;
  overflow:hidden;
  border:1px solid #315672;
  background:#000;
}
.video-frame iframe{width:100%;height:100%;border:0}

/* GALLERY */
.gallery-head{max-width:850px;margin:0 auto 24px;text-align:center}
.gallery-status{text-align:center;color:var(--muted);margin:12px 0 22px}
.gallery-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
  gap:12px;
}
.gallery-item{
  overflow:hidden;
  border-radius:14px;
  border:1px solid #2d506a;
  background:#07121c;
  min-height:170px;
  position:relative;
}
.gallery-item img{
  width:100%;
  height:100%;
  min-height:170px;
  max-height:360px;
  object-fit:cover;
  transition:transform .25s ease;
}
.gallery-item:hover img{transform:scale(1.03)}

/* BUTTONS */
.btn{
  display:inline-block;
  background:#fff;
  color:#07111d;
  border:1px solid #fff;
  border-radius:12px;
  padding:12px 18px;
  text-decoration:none;
  font-weight:800;
  margin:6px;
}
.btn.gold{
  background:var(--gold);
  border-color:var(--gold);
}
.center{text-align:center}

/* FOOTER */
footer{
  padding:34px 15px;
  text-align:center;
  background:#02090f;
  border-top:1px solid var(--line);
  color:#b9c7d5;
}

/* MOBILE */
@media(max-width:640px){
  .language-wrap{padding-top:26px}
  .language-grid{gap:12px}
  .lang-btn{min-width:0;width:calc(50% - 8px);font-size:17px;padding:12px 8px}
  .nav-wrap{position:relative}
  .nav-grid{gap:8px}
  .nav-grid a{
    flex:1 1 calc(50% - 8px);
    text-align:center;
    font-size:14px;
    padding:10px 7px;
  }
  .section{padding:44px 0}
  .gallery-grid{grid-template-columns:repeat(2,1fr)}
}
</style>
</head>
<body>

<section class="language-wrap">
  <div class="language-title" data-i18n="language">Язык:</div>
  <div class="language-grid">
    <button class="lang-btn" data-lang="en">🇬🇧 English</button>
    <button class="lang-btn active" data-lang="ru">🇷🇺 Русский</button>
    <button class="lang-btn" data-lang="ja">🇯🇵 日本語</button>
    <button class="lang-btn" data-lang="zh">🇨🇳 中文</button>
    <button class="lang-btn" data-lang="tr">🇹🇷 Türkçe</button>
    <button class="lang-btn" data-lang="ko">🇰🇷 한국어</button>
    <button class="lang-btn" data-lang="ar">🇸🇦 العربية</button>
  </div>
</section>

<nav class="nav-wrap">
  <div class="nav-grid">
    <a href="#about" data-i18n="nav_about">О нас</a>
    <a href="#sport" data-i18n="nav_sport">Спорт</a>
    <a href="#video" data-i18n="nav_video">Видео</a>
    <a href="#gallery" data-i18n="nav_gallery">Галерея</a>
    <a href="#testimonials" data-i18n="nav_testimonials">Видеоотзывы</a>
    <a href="#game" data-i18n="nav_game">Видеоигра</a>
    <a href="#clubs" data-i18n="nav_clubs">Клубы</a>
    <a href="#leagues" data-i18n="nav_leagues">Лиги</a>
    <a href="#franchise" data-i18n="nav_franchise">Франшиза</a>
    <a href="#rewards" data-i18n="nav_rewards">Вознаграждения</a>
    <a href="#education" data-i18n="nav_education">Образование</a>
    <a href="#social" data-i18n="nav_social">Соцсети</a>
    <a href="#registration" data-i18n="nav_registration">Регистрация</a>
  </div>
</nav>

<header class="hero">
  <div class="container">
    <img id="mainLogo" class="hero-logo" alt="DOSBALL Super Sport International logo" style="display:none">
    <h1>DOSBALL</h1>
    <div class="tagline">SUPER SPORT INTERNATIONAL</div>
    <p style="max-width:800px;margin:18px auto 0" data-i18n="hero_text">
      Новый международный суперспорт, объединяющий динамику командной игры, карьеру спортсмена, клубы, лиги, видеоигру и международную Федерацию.
    </p>
  </div>
</header>

<section id="about" class="section">
  <div class="container">
    <h2 data-i18n="about_title">О DOSBALL</h2>
    <div class="grid">
      <div class="card"><h3>2006</h3><p data-i18n="about_1">Год создания концепции DOSBALL.</p></div>
      <div class="card"><h3>2008 / 2013</h3><p data-i18n="about_2">Этапы официальной регистрации авторской спортивной концепции.</p></div>
      <div class="card"><h3>10–70</h3><p data-i18n="about_3">Широкая возрастная спортивная экосистема.</p></div>
    </div>
  </div>
</section>

<section id="sport" class="section">
  <div class="container">
    <h2 data-i18n="sport_title">Спорт</h2>
    <div class="grid">
      <div class="card"><h3 data-i18n="sport_team">Команда</h3><p>6 игроков на площадке, состав команды — до 25 спортсменов, быстрые замены.</p></div>
      <div class="card"><h3 data-i18n="sport_time">Матч</h3><p>3 периода по 20 минут чистого времени: кроссовки, роликовые коньки, снова кроссовки.</p></div>
      <div class="card"><h3 data-i18n="sport_score">Очки</h3><p>Удар кулаком в вертикальное кольцо — 2 очка; бросок рукой — 1 очко. Используется также удар коленом.</p></div>
      <div class="card"><h3 data-i18n="sport_arena">Арена</h3><p>Площадка баскетбольного размера, по три вертикальных кольца с каждой стороны.</p></div>
    </div>
  </div>
</section>

<section id="video" class="section">
  <div class="container">
    <h2 data-i18n="video_title">Официальное видео</h2>
    <div class="video-frame">
      <iframe src="https://www.youtube.com/embed/AxgTkmCzCDU" title="DOSBALL Official Video" allowfullscreen></iframe>
    </div>
  </div>
</section>

<section id="gallery" class="section">
  <div class="container">
    <div class="gallery-head">
      <h2 data-i18n="gallery_title">Галерея DOSBALL</h2>
      <p data-i18n="gallery_text">
        Единая общая галерея. Фотографии не разделяются по темам — весь DOSBALL представлен одной спортивной историей.
      </p>
    </div>
    <div id="galleryStatus" class="gallery-status">Загрузка фотографий…</div>
    <div id="galleryGrid" class="gallery-grid"></div>
  </div>
</section>

<section id="testimonials" class="section">
  <div class="container">
    <h2 data-i18n="testimonials_title">Видеоотзывы</h2>
    <div id="localVideos" class="grid"></div>
    <p class="small center" style="margin-top:16px">Локальные видео из репозитория будут добавляться автоматически, если они находятся в папках проекта.</p>
  </div>
</section>

<section id="game" class="section">
  <div class="container">
    <h2 data-i18n="game_title">Видеоигра DOSBALL</h2>
    <div class="card center">
      <div class="big-number">$11 / месяц</div>
      <p data-i18n="game_text">Ежемесячный доступ к DOSBALL Video Game. Регистрация в Федерации остаётся бесплатной.</p>
    </div>
  </div>
</section>

<section id="clubs" class="section">
  <div class="container">
    <h2 data-i18n="clubs_title">Клубы DOSBALL</h2>
    <div class="card center">
      <div class="big-number">$30 / месяц</div>
      <p>12 тренировок по 2 часа в месяц в официальном клубе DOSBALL.</p>
    </div>
  </div>
</section>

<section id="leagues" class="section">
  <div class="container">
    <h2 data-i18n="leagues_title">Профессиональные лиги</h2>
    <div class="grid">
      <div class="card"><h3>Premier League</h3><p>Профессиональная соревновательная система DOSBALL.</p></div>
      <div class="card"><h3>High League</h3><p>Следующий уровень спортивного развития и чемпионатов.</p></div>
      <div class="card"><h3>Super National League</h3><p>Высший уровень национального профессионального DOSBALL.</p></div>
    </div>
  </div>
</section>

<section id="franchise" class="section">
  <div class="container">
    <h2 data-i18n="franchise_title">Франшиза</h2>
    <div class="card">
      <p>Официальная франшиза даёт право развивать лицензированный клуб DOSBALL в согласованном регионе. После успешного развития возможна дальнейшая экспансия сети клубов в соответствии с правилами Федерации.</p>
    </div>
  </div>
</section>

<section id="rewards" class="section">
  <div class="container">
    <h2 data-i18n="rewards_title">Вознаграждения за рекомендации</h2>
    <div class="grid">
      <div class="card">
        <div class="big-number">$2</div>
        <p>За очередную оплачиваемую месячную подписку DOSBALL Video Game приглашённого пользователя.</p>
      </div>
      <div class="card">
        <div class="big-number">$3</div>
        <p>За каждый оплаченный месяц тренировок приглашённого спортсмена в клубе DOSBALL — пока он продолжает заниматься и оплачивать клуб.</p>
      </div>
      <div class="card">
        <div class="big-number">10%</div>
        <p>Вознаграждение пригласившему при покупке соответствующей франшизы приглашённым спортсменом, достигшим чемпионского карьерного уровня.</p>
      </div>
    </div>
    <div class="note" style="margin-top:18px">
      Персональная реферальная ссылка активна в оплаченный период доступа к видеоигре. DOSBALL не используется для ставок, азартных игр, лотерей или любых форм гэмблинга.
    </div>
  </div>
</section>

<section id="education" class="section">
  <div class="container">
    <h2 data-i18n="education_title">Образование</h2>
    <div class="card">
      <p>Школы, колледжи и университеты могут использовать официальные правила DOSBALL бесплатно для образовательных и некоммерческих занятий после цифрового соглашения с Федерацией. Платные официальные тренировки и соревнования организуются Федерацией или её уполномоченными партнёрами.</p>
    </div>
  </div>
</section>

<section id="social" class="section">
  <div class="container">
    <h2 data-i18n="social_title">Социальная ответственность</h2>
    <div class="grid">
      <div class="card"><h3>Fair Play</h3><p>Честная игра, уважение и единые спортивные правила.</p></div>
      <div class="card"><h3>Unity</h3><p>DOSBALL объединяет спорт, семью, общество, государство и бизнес.</p></div>
      <div class="card"><h3>Progress</h3><p>Развитие спортсменов, клубов, тренеров и международного спортивного движения.</p></div>
    </div>
  </div>
</section>

<section id="registration" class="section">
  <div class="container center">
    <h2 data-i18n="registration_title">Регистрация</h2>
    <p style="max-width:720px;margin:0 auto 18px">Регистрация участника DOSBALL Federation — бесплатная.</p>
    <a class="btn gold" href="mailto:dosballsupersport@gmail.com">DOSBALL Federation</a>
  </div>
</section>

<footer>
  <strong>DOSBALL SUPER SPORT INTERNATIONAL</strong><br>
  <span>Fair Play • Unity • Progress</span><br>
  <span>© 2026 DOSBALL. All rights reserved.</span>
</footer>

<script>
/* =========================================================
   DOSBALL FINAL INDEX 7
   IMPORTANT FIX:
   The gallery does NOT depend only on photo01.jpg/photo02.jpg.
   It reads the PUBLIC GitHub repository tree and finds image
   files automatically, including long hashed filenames.
   ========================================================= */

const REPO_OWNER = "askardzhambolatov";
const REPO_NAME  = "dosball-super-sport";
const BRANCH     = "main";

const GITHUB_TREE_API =
  `https://api.github.com/repos/${REPO_OWNER}/${REPO_NAME}/git/trees/${BRANCH}?recursive=1`;

const RAW_BASE =
  `https://raw.githubusercontent.com/${REPO_OWNER}/${REPO_NAME}/${BRANCH}/`;

const IMAGE_EXT = /\.(jpg|jpeg|png|webp|gif|avif)$/i;
const VIDEO_EXT = /\.(mp4|webm|mov|m4v)$/i;
const HTML_EXT  = /\.(html?|css|js|json|md|txt|zip)$/i;

/* Files that should not become gallery photos */
function isLikelyLogo(path){
  const n = path.toLowerCase();
  return n.includes("logo") ||
         n.includes("favicon") ||
         n.includes("icon") ||
         n.includes("badge") ||
         n.includes("federation-logo") ||
         n.includes("club-logo");
}

function encodeRepoPath(path){
  return path.split("/").map(encodeURIComponent).join("/");
}

async function loadRepositoryMedia(){
  const gallery = document.getElementById("galleryGrid");
  const status = document.getElementById("galleryStatus");
  const videoBox = document.getElementById("localVideos");
  const logo = document.getElementById("mainLogo");

  try{
    const response = await fetch(GITHUB_TREE_API, {
      headers: {"Accept":"application/vnd.github+json"},
      cache:"no-store"
    });

    if(!response.ok) throw new Error("GitHub API: " + response.status);

    const data = await response.json();
    const files = (data.tree || [])
      .filter(x => x.type === "blob")
      .map(x => x.path);

    const imageFiles = files.filter(p => IMAGE_EXT.test(p));
    const videoFiles = files.filter(p => VIDEO_EXT.test(p));

    /* Prefer newest approved-looking logo if filenames contain logo words.
       Otherwise the page keeps the clean text hero without inventing a logo. */
    const logos = imageFiles.filter(isLikelyLogo);
    if(logos.length){
      const preferred =
        logos.find(p => /federation/i.test(p)) ||
        logos.find(p => /dosball/i.test(p)) ||
        logos[logos.length-1];
      logo.src = RAW_BASE + encodeRepoPath(preferred);
      logo.style.display = "block";
      logo.onerror = () => logo.style.display = "none";
    }

    /* UNIFIED GALLERY:
       all repository photos, regardless of folder or filename.
       Only obvious logo/icon files are excluded. */
    const galleryFiles = imageFiles.filter(p => !isLikelyLogo(p));

    gallery.innerHTML = "";

    galleryFiles.forEach(path => {
      const item = document.createElement("div");
      item.className = "gallery-item";

      const img = document.createElement("img");
      img.loading = "lazy";
      img.alt = "DOSBALL gallery";
      img.src = RAW_BASE + encodeRepoPath(path);

      img.onerror = () => item.remove();

      item.appendChild(img);
      gallery.appendChild(item);
    });

    status.textContent = galleryFiles.length
      ? `Найдено фотографий: ${galleryFiles.length}`
      : "Фотографии пока не найдены в репозитории.";

    /* AUTO LOCAL VIDEOS */
    videoBox.innerHTML = "";
    videoFiles.forEach(path => {
      const card = document.createElement("div");
      card.className = "card";

      const v = document.createElement("video");
      v.controls = true;
      v.preload = "metadata";
      v.playsInline = true;
      v.style.width = "100%";
      v.style.borderRadius = "12px";
      v.src = RAW_BASE + encodeRepoPath(path);

      card.appendChild(v);
      videoBox.appendChild(card);
    });

    if(!videoFiles.length){
      videoBox.innerHTML =
        '<div class="card center"><p class="small">Локальные видео пока не найдены. Официальное видео доступно выше.</p></div>';
    }

  }catch(err){
    console.error(err);

    /* Fallback for numbered photos if GitHub API is temporarily unavailable */
    status.textContent = "Загружаем резервную галерею…";
    gallery.innerHTML = "";

    const candidates = [];
    const folders = ["gallery/","images/","photos/",""];
    const exts = ["jpg","jpeg","png","webp"];

    for(let i=1;i<=100;i++){
      const num = String(i).padStart(2,"0");
      for(const folder of folders){
        for(const ext of exts){
          candidates.push(`${folder}photo${num}.${ext}`);
        }
      }
    }

    let shown = 0;
    candidates.forEach(path => {
      const item = document.createElement("div");
      item.className = "gallery-item";
      item.style.display = "none";

      const img = document.createElement("img");
      img.loading = "lazy";
      img.alt = "DOSBALL gallery";
      img.src = RAW_BASE + encodeRepoPath(path);

      img.onload = () => {
        shown++;
        item.style.display = "block";
        status.textContent = `Найдено фотографий: ${shown}`;
      };
      img.onerror = () => item.remove();

      item.appendChild(img);
      gallery.appendChild(item);
    });

    setTimeout(() => {
      if(!shown) status.textContent =
        "Галерея не смогла получить список файлов. Проверьте, что фотографии загружены в ветку main.";
    }, 5000);
  }
}

/* SIMPLE LANGUAGE SWITCH */
const translations = {
  ru:{
    language:"Язык:",nav_about:"О нас",nav_sport:"Спорт",nav_video:"Видео",
